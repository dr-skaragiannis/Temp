new file mode 100644
index 0000000..2a43851
--- /dev/null
+++ b/evaluation/meter/probes/BatteryProbe.kt
@@ -0,0 +1,77 @@
+package org.meshcrowd.probes
+
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.BatteryManager
+import android.os.Handler
+import android.os.Looper
+import android.os.PowerManager
+import android.os.SystemClock
+import java.io.File
+
+/**
+ * Samples the battery gauge, the instantaneous current where the HAL exposes it, and the
+ * Doze/screen state on a fixed period. Writes one CSV per leg so drain can be computed
+ * independently of batterystats.
+ *
+ * Drop-in: create in whatever owns the sensing session, call start()/stop() around it.
+ */
+class BatteryProbe(
+    private val context: Context,
+    private val dir: File,
+    private val periodMs: Long = 5_000L,
+) {
+    private val handler = Handler(Looper.getMainLooper())
+    private val battery = context.getSystemService(Context.BATTERY_SERVICE) as BatteryManager
+    private val power = context.getSystemService(Context.POWER_SERVICE) as PowerManager
+    private var t0 = 0L
+    private lateinit var out: File
+    private var running = false
+
+    private val tick = object : Runnable {
+        override fun run() {
+            if (!running) return
+            sample()
+            handler.postDelayed(this, periodMs)
+        }
+    }
+
+    fun start(label: String) {
+        if (!dir.exists()) dir.mkdirs()
+        out = File(dir, "battery-$label.csv")
+        out.writeText("elapsed_s,level,scale,voltage_duV,temperature_dC,status,plugged,current_uA,device_idle,light_idle,screen\n")
+        t0 = SystemClock.elapsedRealtime()
+        running = true
+        handler.post(tick)
+    }
+
+    fun stop() {
+        running = false
+        handler.removeCallbacks(tick)
+    }
+
+    private fun sample() {
+        val intent: Intent? = context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+        val level = intent?.getIntExtra(BatteryManager.EXTRA_LEVEL, -1) ?: -1
+        val scale = intent?.getIntExtra(BatteryManager.EXTRA_SCALE, -1) ?: -1
+        val volt = intent?.getIntExtra(BatteryManager.EXTRA_VOLTAGE, -1) ?: -1
+        val temp = intent?.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, -1) ?: -1
+        val status = intent?.getIntExtra(BatteryManager.EXTRA_STATUS, -1) ?: -1
+        val plugged = intent?.getIntExtra(BatteryManager.EXTRA_PLUGGED, -1) ?: -1
+        // CURRENT_NOW is uA on most HALs and negative while discharging; -1 where unavailable.
+        val current = runCatching { battery.getIntProperty(BatteryManager.BATTERY_PROPERTY_CURRENT_NOW) }.getOrDefault(-1)
+        val elapsed = (SystemClock.elapsedRealtime() - t0) / 1000.0
+        out.appendText(
+            listOf(
+                "%.1f".format(elapsed), level, scale, volt * 1000, temp, status, plugged, current,
+                if (power.isDeviceIdleMode) 1 else 0,
+                if (power.isDeviceLightIdleMode) 1 else 0,
+                screenState(),
+            ).joinToString(",") + "\n"
+        )
+    }
+
+    private fun screenState(): String =
+        if (power.isInteractive) "on" else "off"
+}
diff --git a/evaluation/meter/probes/ScanCadenceLogger.kt b/evaluation/meter/probes/ScanCadenceLogger.kt
new file mode 100644
index 0000000..a3dabfd
--- /dev/null
+++ b/evaluation/meter/probes/ScanCadenceLogger.kt
@@ -0,0 +1,120 @@
+package org.meshcrowd.probes
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.Handler
+import android.os.Looper
+import android.os.PowerManager
+import android.os.SystemClock
+import java.io.File
+
+/**
+ * Records whether the OS actually delivers the scan cadence the app asks for.
+ *
+ * Call the on* methods from your real scan callbacks; the logger aggregates per window
+ * (default 30 s, matching Android's scan-throttle window) and writes one row per window.
+ * That is the evidence for "operational consequence of throttling": epochs *attempted* vs
+ * epochs *delivered*, split by screen state and Doze state.
+ */
+class ScanCadenceLogger(
+    private val context: Context,
+    private val dir: File,
+    private val windowMs: Long = 30_000L,
+) {
+    private val handler = Handler(Looper.getMainLooper())
+    private val power by lazy { context.getSystemService(Context.POWER_SERVICE) as PowerManager }
+    private lateinit var out: File
+    private var labelName: String = "session"
+    private var t0 = 0L
+    private var running = false
+
+    // window accumulators
+    private var bleStarts = 0
+    private var bleResults = 0
+    private var bleLinks = 0
+    private var wifiPolls = 0
+    private var wifiFreshPolls = 0
+    private var wifiStartScanTried = 0
+    private var wifiStartScanAccepted = 0
+    private var epochsAttempted = 0
+    private var epochsCompleted = 0
+
+    private val screenReceiver = object : BroadcastReceiver() {
+        override fun onReceive(c: Context, i: Intent) {
+            when (i.action) {
+                Intent.ACTION_SCREEN_ON -> writeEvent("screen_on")
+                Intent.ACTION_SCREEN_OFF -> writeEvent("screen_off")
+            }
+        }
+    }
+
+    private val flush = object : Runnable {
+        override fun run() {
+            if (!running) return
+            flushWindow()
+            handler.postDelayed(this, windowMs)
+        }
+    }
+
+    fun start(label: String) {
+        labelName = label
+        if (!dir.exists()) dir.mkdirs()
+        out = File(dir, "cadence-$label.csv")
+        out.writeText(
+            "window_start_s,ble_scan_starts,ble_results,ble_links,wifi_polls,wifi_polls_fresh," +
+                "wifi_startscan_tried,wifi_startscan_accepted,epochs_attempted,epochs_completed," +
+                "screen_on,device_idle,light_idle\n"
+        )
+        t0 = SystemClock.elapsedRealtime()
+        running = true
+        context.registerReceiver(screenReceiver, IntentFilter().apply {
+            addAction(Intent.ACTION_SCREEN_ON); addAction(Intent.ACTION_SCREEN_OFF)
+        })
+        handler.post(flush)
+    }
+
+    fun stop() {
+        running = false
+        handler.removeCallbacks(flush)
+        runCatching { context.unregisterReceiver(screenReceiver) }
+    }
+
+    // ---- call these from the app -------------------------------------------------
+    fun onBleScanStarted() { bleStarts++ }
+    fun onBleScanResults(count: Int, distinctLinks: Int) {
+        bleResults += count
+        bleLinks = maxOf(bleLinks, distinctLinks)
+    }
+    /** [fresh] true when the results are newer than the previous poll's timestamp list. */
+    fun onWifiPoll(fresh: Boolean) { wifiPolls++; if (fresh) wifiFreshPolls++ }
+    fun onWifiStartScan(accepted: Boolean) { wifiStartScanTried++; if (accepted) wifiStartScanAccepted++ }
+    fun onEpochAttempted() { epochsAttempted++ }
+    fun onEpochCompleted() { epochsCompleted++ }
+    /** Timestamped marker in events-<label>.csv; used to recover epoch gaps. */
+    fun noteEvent(name: String) { writeEvent(name) }
+    // ------------------------------------------------------------------------------
+
+    private fun flushWindow() {
+        val el = (SystemClock.elapsedRealtime() - t0) / 1000.0
+        out.appendText(
+            listOf(
+                "%.1f".format(el), bleStarts, bleResults, bleLinks, wifiPolls, wifiFreshPolls,
+                wifiStartScanTried, wifiStartScanAccepted, epochsAttempted, epochsCompleted,
+                if (power.isInteractive) 1 else 0,
+                if (power.isDeviceIdleMode) 1 else 0,
+                if (power.isDeviceLightIdleMode) 1 else 0,
+            ).joinToString(",") + "\n"
+        )
+        bleStarts = 0; bleResults = 0; bleLinks = 0
+        wifiPolls = 0; wifiFreshPolls = 0
+        wifiStartScanTried = 0; wifiStartScanAccepted = 0
+        epochsAttempted = 0; epochsCompleted = 0
+    }
+
+    private fun writeEvent(name: String) {
+        val el = (SystemClock.elapsedRealtime() - t0) / 1000.0
+        File(dir, "events-$labelName.csv").appendText("%.1f,%s\n".format(el, name))
+    }
+}
diff --git a/evaluation/meter/probes/StorageProbe.kt b/evaluation/meter/probes/StorageProbe.kt
new file mode 100644
index 0000000..e3b3a20
--- /dev/null
+++ b/evaluation/meter/probes/StorageProbe.kt
@@ -0,0 +1,69 @@
+package org.meshcrowd.probes
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import java.io.File
+
+/**
+ * Tracks how much the app's own logging costs on disk, and (via [trafficSnapshot]) how much
+ * mobile/Wi-Fi traffic the process accounts for. No root needed: only the app's own
+ * directories are measured, which is exactly what the deployment question is about.
+ */
+class StorageProbe(private val context: Context, private val periodMs: Long = 60_000L) {
+    private val handler = Handler(Looper.getMainLooper())
+    private lateinit var out: File
+    private var t0 = 0L
+    private var running = false
+
+    private val tick = object : Runnable {
+        override fun run() {
+            if (!running) return
+            sample(); handler.postDelayed(this, periodMs)
+        }
+    }
+
+    fun start(label: String) {
+        val d = context.getExternalFilesDir("meter") ?: context.filesDir
+        out = File(d, "storage-$label.csv")
+        out.writeText("elapsed_s,files_bytes,cache_bytes,nobackup_bytes,log_files,log_bytes_max,log_bytes_total,traffic\n")
+        t0 = SystemClock.elapsedRealtime()
+        running = true
+        handler.post(tick)
+    }
+
+    fun stop() { running = false; handler.removeCallbacks(tick) }
+
+    private fun sample() {
+        val files = context.filesDir
+        val cache = context.cacheDir
+        val noBackup = File(context.dataDir, "no_backup")
+        val logs = files.listFiles { f: File -> f.isFile && !f.name.endsWith(".csv") }?.toList() ?: emptyList()
+        val el = (SystemClock.elapsedRealtime() - t0) / 1000.0
+        out.appendText(
+            listOf(
+                "%.1f".format(el), sizeOf(files), sizeOf(cache),
+                if (noBackup.exists()) sizeOf(noBackup) else 0,
+                logs.size, logs.maxOfOrNull { it.length() } ?: 0L, logs.sumOf { it.length() },
+                trafficLine(),
+            ).joinToString(",") + "\n"
+        )
+    }
+
+    private fun sizeOf(dir: File): Long {
+        if (!dir.exists()) return 0L
+        return dir.walkTopDown().filter { it.isFile && it.canRead() }.map { it.length() }.sum()
+    }
+
+    /** Per-UID traffic from the same counters Settings shows: the paper's "no data plan
+     *  impact" claim is only as good as these four numbers. */
+    fun trafficLine(): String {
+        val rx = android.net.TrafficStats.getMobileRxBytes()
+        val tx = android.net.TrafficStats.getMobileTxBytes()
+        val urx = android.net.TrafficStats.getUidRxBytes(android.os.Process.myUid())
+        val utx = android.net.TrafficStats.getUidTxBytes(android.os.Process.myUid())
+        // ';' inside the field: a comma would split the column in the CSV.
+        return "mobile_rx=$rx;mobile_tx=$tx;uid_rx=$urx;uid_tx=$utx"
+    }
+}
diff --git a/evaluation/meter/protocol.md b/evaluation/meter/protocol.md
new file mode 100644
index 0000000..50be080
--- /dev/null
+++ b/evaluation/meter/protocol.md
@@ -0,0 +1,98 @@
+# Measurement protocol — battery, storage, background operation, usability
+
+Everything below is a *recording* protocol: fixed conditions, fixed duration, machine-generated
+logs, no hand-transcribed numbers. Fill `protocol-results.md` as you go; it is the file I need
+back together with `runs/`.
+
+Conventions: one leg = one uninterrupted run. Start the log, wait 5 min for the battery gauge to
+settle, then start the timer (`run_leg.sh` does this). Label runs `<leg>-<rep>` with rep ∈ {1,2,3}.
+Randomise leg order; write the order down. Ambient temperature recorded at start/end
+(`run_leg.sh` grabs it from `dumpsys battery`).
+
+---
+
+## Part B — power, background operation, storage, traffic
+
+### Conditions
+
+| Leg | Screen | Radios/scanning | Other | Question it answers |
+|---|---|---|---|---|
+| B1 | off | app not installed/stopped | — | idle floor of this handset at these settings |
+| B2 | off | meter/app scanning, 15 s epochs | foreground service running | **the deployment case**: background drain, screen-off scan availability |
+| B3 | on, 40 % brightness, dashboard visible | as B2 | — | cost of the operator view |
+| B4 | off | two phones, transit sessions every 5 min | RFCOMM + L2CAP | mesh/perimeter configuration |
+| B5 | off, then forced Doze | scanning only | `adb shell dumpsys deviceidle force-idle` for the last 30 min | does the duty cycle survive deep idle, and how much of it is lost |
+| B6 | off | scanning, **battery saver ON** | — | what a normal user's settings do to range |
+
+3 reps each; 30 min for B1–B3, 60 min for B4–B6 (long enough that a 15 s epoch count is
+meaningful). Between reps: unplug, let the phone idle 10 min, re-run.
+
+### Captured per leg (automated by `scripts/run_leg.sh`)
+
+- `batterystats-before.txt`, `batterystats-after.txt` — `dumpsys batterystats` full report
+- `batterystats-checkin.txt` — machine-parseable `--checkin` dump
+- `battery.csv` — 5 s samples: `elapsed_s,level,scale,voltage_duV,temperature_dC,status,plugged,current_uA,idle_state,light_idle,screen`
+- `storage.csv` — 60 s samples: `elapsed_s,files_bytes,cache_bytes,nobackup_bytes,session_files,exported_bytes`
+- `netstats-before.txt` / `-after.txt` — `dumpsys netstats --uid` (per-UID mobile/Wi-Fi bytes)
+- `deviceidle-history.txt` — `dumpsys deviceidle` + `dumpsys deviceidle history`
+- `app-logs/` — the app's own CSV/JSON exports (scan cadence, epochs delivered, refusals)
+- `logcat.txt` — `adb logcat -d` snapshot, kept for service kills/ANRs (a killed service is a
+  result, not noise — report it)
+
+### Derived quantities (computed by `analysis/parse_leg.py` then `analysis/meter_report.py`)
+
+1. `drain_pct_per_h` = (level_start − level_end)/hours, and `drain_mah_per_h` from
+   `BatteryProperty CURRENT_NOW` medians where the HAL exposes it, else from rated capacity.
+2. `net_cost_pct_per_h` = leg drain minus B1 drain (the number a reviewer actually wants).
+3. `ble_scan_requests_per_h`, `ble_scan_results_per_h`, `wifi_polls_per_h`,
+   `wifi_startscan_accepted_ratio` (Android 9+ returns false for third-party apps — report it),
+   `epochs_delivered_per_h`, `epoch_gap_s` median/p95 (from `events-<label>.csv`, which the app stamps at every epoch attempt).
+4. `scans_per_hour_screen_off / _doze / _idle` → the operational consequence of throttling.
+5. `storage_bytes_per_h`, `…_per_month_at_campaign_cadence`, `export_bytes_per_session`,
+   `mobile_bytes_tx/rx` (expected ≈ 0 — say so with the number, not with an adjective).
+6. Service survival: count of `started`/`killed` events, and whether the notification produced a
+   wake-up storm (`dumpsys batterystats` "Wake lock" section).
+
+Report every quantity as median [IQR] over the three reps with the exposure `T`; never a single run.
+
+---
+
+## Part U — usability, permission burden, and consent
+
+Recruit **6–10** participants who are not authors. Students/colleagues are fine; record role and
+prior Android development experience (that is your only stratification at this n).
+**Do this only after the consent form is signed and kept** — the same form covers the field
+campaign, which closes the outstanding consent item.
+
+### Session (≈35 min, think-aloud, no assistance unless the participant asks)
+
+| # | Task | Success criterion (objective) |
+|---|---|---|
+| U1 | Install the APK, grant everything the app asks for, reach the Sense tab | first live link counter > 0; record **taps and dialogs count** and **time from launch to first classification** |
+| U2 | Start sensing, place the phone as instructed, verify a person crossing is flagged | event appears within 60 s |
+| U3 | Open Scans, explain what one stored epoch says out loud | correctly states window length, one link that changed, and the verdict |
+| U4 | Set the radius preset and explain what the envelope means | mentions distance-conditioned limit, not "unlimited range" |
+| U5 | Read the Sense tab's classifier confidence and say whether it is a probability of a person or of the class being right | correct interpretation (this probes the displayed-vs-realized gap) |
+| U6 | Configure a two-phone transit barrier at a chosen separation and start it | both phones show the barrier active |
+| U7 | Export a session, find the file, describe who could read it | export completes; states on-device/no-server correctly |
+| U8 | Reopen the app after 1 h in the drawer and say whether sensing continued | correct answer against the log (this is the background-operation literacy check) |
+
+Per task record: `completed ∈ {yes, partial, no}`, `time_s`, `errors`, `help_requested`,
+and one NASA-TLX score (0–100) for the whole session. After the session: **SUS** (10 items) and
+**UMUX-Lite** (4 items), plus two open questions: "what would you not run this on, and why" and
+"what did you expect the mesh to do that you now doubt".
+
+### Reported
+
+completion rate with Wilson interval per task, median time [IQR], error counts, SUS mean ± SD and
+UMUX-Lite scores, and the permission-burden numbers from U1 (dialogs, taps, time to first
+classification). With n ≤ 10 report medians and intervals and call it a pilot — do not test
+hypotheses, describe.
+
+### Consent
+
+`templates/consent-form.md` is a fill-in template: purpose, what is recorded (task times,
+errors, questionnaire answers, no audio unless you record it), storage location and retention,
+right to withdraw, and the fact that crossing subjects are the experimenters themselves. Keep
+signed copies; state in the paper that participants consented and that the field campaign's
+bystanders were not identifiable because no identifiers are retained.
diff --git a/evaluation/meter/scripts/build_apk_local.sh b/evaluation/meter/scripts/build_apk_local.sh
new file mode 100755
index 0000000..445f345
--- /dev/null
+++ b/evaluation/meter/scripts/build_apk_local.sh
@@ -0,0 +1,71 @@
+#!/usr/bin/env bash
+# Build MeshCrowdMeter-debug.apk without Gradle, for sandboxes/CI that only have a JDK,
+# kotlinc and the raw SDK zips. The canonical path is still
+#   cd meter-app && ./gradlew :app:assembleDebug
+# This script produces the same classes + resources + a debug signature, so it can be used
+# to prove the sources compile and to put an APK on the handset when Gradle is unavailable.
+#
+# Env overrides: ANDROID_SDK (needs platforms/android-XX/android.jar + a build-tools dir),
+#                KOTLINC, COMPILE_SDK.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+SDK="${ANDROID_SDK:-$HOME/android-sdk}"
+KOT="${KOTLINC:-$HOME/kotlinc/bin/kotlinc}"
+API="${COMPILE_SDK:-35}"
+
+PLAT="$SDK/platforms/android-$API/android.jar"
+BT="$(ls -d "$SDK"/build-tools/* | sort -V | tail -1)"
+[ -x "$BT/aapt2" ] || { echo "aapt2 not found under $SDK/build-tools"; exit 1; }
+[ -f "$PLAT" ] || { echo "missing $PLAT"; exit 1; }
+[ -x "$KOT" ] || { echo "missing kotlinc at $KOT"; exit 1; }
+
+OUT="$ROOT/dist"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+mkdir -p "$WORK/klasses" "$WORK/dex" "$OUT"
+
+SRC=()
+while IFS= read -r f; do SRC+=("$f"); done < <(
+  find "$ROOT/meter-app/app/src/main/java" -name '*.kt'
+  find "$ROOT/probes" -maxdepth 1 -name '*.kt'
+)
+echo "==> kotlinc, ${#SRC[@]} files, jvm-target 1.8, target $API"
+"$KOT" -nowarn -classpath "$PLAT" -jvm-target 1.8 -d "$WORK/klasses" "${SRC[@]}"
+
+echo "==> d8 (app classes + kotlin stdlib)"
+CP=()
+while IFS= read -r c; do CP+=("$c"); done < <(find "$WORK/klasses" -name '*.class')
+STDLIB="$(dirname "$(dirname "$KOT")")/lib"
+for j in kotlin-stdlib.jar kotlin-stdlib-jdk7.jar kotlin-stdlib-jdk8.jar; do
+  [ -f "$STDLIB/$j" ] && CP+=("$STDLIB/$j")
+done
+"$BT/d8" --release --min-api 26 --lib "$PLAT" --output "$WORK/dex" "${CP[@]}"
+
+echo "==> aapt2 compile + link"
+# Gradle's `namespace` supplies the manifest package; the raw aapt2 path needs it inline,
+# so link against a temporary copy instead of editing the committed manifest.
+sed -E 's|<manifest xmlns:android="[^"]*">|<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.meshcrowd.meter">|' \
+  "$ROOT/meter-app/app/src/main/AndroidManifest.xml" > "$WORK/AndroidManifest.xml"
+grep -q 'package="org.meshcrowd.meter"' "$WORK/AndroidManifest.xml" || { echo "could not inject package attribute"; exit 1; }
+"$BT/aapt2" compile --dir "$ROOT/meter-app/app/src/main/res" -o "$WORK/res.zip"
+"$BT/aapt2" link -o "$WORK/base.apk" -I "$PLAT" \
+  --manifest "$WORK/AndroidManifest.xml" \
+  --min-sdk-version 26 --target-sdk-version "$API" \
+  --version-code 1 --version-name meter-1.0 \
+  --java "$WORK/genjava" "$WORK/res.zip"
+
+echo "==> zip + align + sign"
+cp "$WORK/base.apk" "$WORK/unsigned.apk"
+(cd "$WORK/dex" && zip -q "$WORK/unsigned.apk" classes.dex)
+"$BT/zipalign" -f -p 4 "$WORK/unsigned.apk" "$WORK/aligned.apk"
+KS="$WORK/debug.keystore"
+keytool -genkeypair -keystore "$KS" -alias androiddebugkey -storepass android -keypass android \
+  -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Android Debug,O=Android,C=US" >/dev/null 2>&1
+"$BT/apksigner" sign --ks "$KS" --ks-pass pass:android --key-pass pass:android \
+  --out "$OUT/MeshCrowdMeter-debug.apk" "$WORK/aligned.apk"
+
+echo "==> verify"
+"$BT/apksigner" verify --print-certs "$OUT/MeshCrowdMeter-debug.apk" | head -4
+"$BT/aapt2" dump badging "$OUT/MeshCrowdMeter-debug.apk" | grep -E "^(package|sdkVersion|targetSdkVersion|uses-permission|launchable)" | sed 's/^/    /'
+ls -l "$OUT/MeshCrowdMeter-debug.apk"
