@@ -0,0 +1,116 @@
+#!/usr/bin/env bash
+# run_tests.sh — exercise the analysers end to end on the SYNTHETIC fixture.
+#
+# What this proves: the capture format the probes and run_leg.sh write is the format the
+# analysers read, the units come out right, and a missing capture produces "n/m" instead of a
+# zero. What it does NOT prove: nothing about the phone. Every value here is generated by
+# tests/make_fixture.py; none of it may reach the manuscript.
+set -u -o pipefail
+cd "$(dirname "$0")/.."
+A=analysis; T=tests; F=$T/fixture
+rc=0
+say() { printf '%-46s %s\n' "$1" "$2"; }
+chk() { # name, expected, actual
+  if [ "$2" = "$3" ]; then say "$1" "PASS ($3)"; else say "$1" "FAIL expected=$2 got=$3"; rc=1; fi
+}
+jget() { python3 -c "
+import json,sys
+d=json.load(open(sys.argv[1]))
+cur=d
+for k in sys.argv[2].split('.'):
+    cur = cur.get(k) if isinstance(cur,dict) else None
+    if cur is None: break
+print('NULL' if cur is None else (round(cur,4) if isinstance(cur,float) else cur))" "$1" "$2"; }
+
+echo "== regenerating fixture"
+python3 $T/make_fixture.py > /dev/null || { echo "fixture generation failed"; exit 1; }
+[ -f $T/fixture/SYNTHETIC-FIXTURE.txt ] || { echo "fixture lost its SYNTHETIC marker"; exit 1; }
+
+echo "== parse_leg.py"
+python3 $A/parse_leg.py $F/B2-sensing-screen-off_1 --uid 10234 > /dev/null || { echo "parse B2 failed"; exit 1; }
+python3 $A/parse_leg.py $F/B5-forced-doze_1 > /dev/null || { echo "parse B5 failed"; exit 1; }
+M2=$F/B2-sensing-screen-off_1/metrics.json
+M5=$F/B5-forced-doze_1/metrics.json
+chk "drain = 2%/20min -> 6.0 %/h"    "6.0"   "$(jget $M2 soc.soc_pct_per_h)"
+chk "SOC steps observed"              "2"     "$(jget $M2 soc.soc_steps_observed)"
+chk "quantisation floor = 3 %/h"      "3.0"   "$(jget $M2 soc.quantisation_pct_per_h_per_step)"
+chk "CURRENT_NOW mean -> 320.9 mA"    "320.92" "$(jget $M2 current.mA_discharge)"
+chk "IQR is low-then-high"            "309.55" "$(python3 -c "import json;print(json.load(open('$M2'))['current']['mA_iqr'][0])")"
+chk "ble bursts requested (sum)"      "200"   "$(jget $M2 cadence.totals.ble_scan_starts)"
+chk "ble results (sum)"               "1040"  "$(jget $M2 cadence.totals.ble_results)"
+chk "results per burst"               "5.2"   "$(jget $M2 cadence.delivered_per_start)"
+chk "wifi startScan accepted ratio"   "0.0"   "$(jget $M2 cadence.wifi_startscan_accepted_ratio)"
+chk "epoch completion ratio 68/80"    "0.85"  "$(jget $M2 cadence.epoch_completion_ratio)"
+chk "epoch gap median 15 s"           "15.0"  "$(jget $M2 events.epoch_gap_s.median)"
+chk "no missed epochs"                "0"     "$(jget $M2 events.epoch_gap_s.missed_epochs_gt_2x_nominal)"
+chk "storage growth over leg"         "188000" "$(jget $M2 storage.bytes_growth)"
+chk "mobile bytes tiny but reported"  "40"    "$(jget $M2 storage.mobile_bytes_total)"
+chk "batterystats uid mAh"            "4.81"  "$(jget $M2 batterystats.estimated_mah_for_uid.'uid 10234')"
+chk "wake lock seconds 1m12s"         "72.3"  "$(python3 -c "import json;print(json.load(open('$M2'))['batterystats']['wake_lock_seconds']['u0a234/MeterService'])")"
+chk "app-side battery preferred"      "battery-B2.csv" "$(jget $M2 battery_source)"
+chk "no gaps on a complete leg"       "0"     "$(python3 -c "import json;print(len(json.load(open('$M2'))['gaps']))")"
+
+echo "== a leg with no app logs must yield nulls, not zeros"
+chk "B5 cadence not measured"         "NULL"  "$(jget $M5 cadence.totals.ble_scan_starts)"
+chk "B5 flags a gap"                  "cadence" "$(python3 -c "import json;print(json.load(open('$M5'))['gaps'][0])")"
+chk "B5 drain still parsed from shell" "6.0"  "$(jget $M5 soc.soc_pct_per_h)"
+
+echo "== meter_report.py"
+python3 $A/meter_report.py $M2 $M5 --capacity-mah 4600 --outdir $T/out > /dev/null || { echo "meter_report failed"; exit 1; }
+chk "measurements.tex exists"         "yes" "$([ -f $T/out/measurements.tex ] && echo yes)"
+chk "numbers.md exists"               "yes" "$([ -f $T/out/numbers.md ] && echo yes)"
+chk "missing leg renders as n/m"      "1"    "$(grep -c 'n/m' $T/out/measurements.tex | head -1 | awk '{print ($1>0)?1:0}')"
+grep -q "276.00" $T/out/measurements.tex && say "mAh/h = 6%/h x 4600 mAh" "PASS (276.00)" \
+  || { say "mAh/h = 6%/h x 4600 mAh" "FAIL"; rc=1; }
+
+echo "== usability_report.py"
+python3 $A/usability_report.py --tasks $F/usability/usability_tasks.csv \
+  --survey $F/usability/usability_survey.csv --outdir $T/out > /dev/null || { echo "usability failed"; exit 1; }
+chk "SUS median (4x50, 4x37.5)"       "43.8"  "$(grep -o 'usability was [0-9.]*' $T/out/usability_numbers.md | awk '{print $3}')"
+chk "UMUX median = 75"                "75.0"  "$(grep -o 'UMUX-Lite gave [0-9.]*' $T/out/usability_numbers.md | awk '{print $3}')"
+chk "pilot label present"             "1"     "$(grep -ci pilot $T/out/usability_numbers.md | head -1 | awk '{print ($1>0)?1:0}')"
+# the fixture makes U4 deliberately hard: only P07 and P08 succeed -> 2/8.
+chk "task U4 success 2/8"             "2/8"   "$(grep -o 'U4 & task4 & [0-9]*/[0-9]*' $T/out/usability.tex | awk -F'& ' '{print $3}')"
+# Wilson 95% for 2/8, computed by hand: p=.25, den=1.4802 -> [7.1, 59.1]
+chk "Wilson CI for 2/8"               "[7.1,59.1]" "$(python3 -c "
+import re
+row = [l for l in open('$T/out/usability.tex') if l.strip().startswith('U4')][0]
+m = re.search(r'\[([0-9.]+),\\\\,([0-9.]+)\]', row)
+print('[%s,%s]' % m.groups() if m else 'none')")"
+chk "no 0/8 task prints a zero width CI" "0"   "$(grep -c '\[0.0,0.0\]' $T/out/usability.tex)"
+
+echo "== generated LaTeX must be structurally sound (brace + column lint)"
+python3 - "$T/out/measurements.tex" "$T/out/usability.tex" <<'PYEOF' || rc=1
+import re, sys
+bad = 0
+for f in sys.argv[1:]:
+    t = open(f, encoding="utf-8").read()
+    if t.count("{") != t.count("}"):
+        print(f"  {f}: unbalanced braces {t.count('{')} vs {t.count('}')}"); bad = 1
+    for env in ("table", "table*", "tabular"):
+        o = len(re.findall(r"\\begin\{" + re.escape(env) + r"\}", t))
+        c = len(re.findall(r"\\end\{" + re.escape(env) + r"\}", t))
+        if o != c:
+            print(f"  {f}: {env} begin={o} end={c}"); bad = 1
+    for blk in re.findall(r"\\begin\{tabular\}\{([^}]*)\}(.*?)\\end\{tabular\}", t, re.S):
+        cols = len(re.sub(r"[^lcrpXm]", "", blk[0]))
+        for row in blk[1].strip().splitlines():
+            r = row.strip()
+            if not r or r.startswith("%") or "\\\\" not in r:
+                continue
+            if r.startswith("\\multicolumn") or "toprule" in r or "midrule" in r or "bottomrule" in r:
+                continue
+            n = len([c for c in r.split("\\\\")[0].split("&")])
+            if n != cols:
+                print(f"  {f}: tabular row has {n} cells, header declares {cols}: {r[:70]}"); bad = 1
+print("  LaTeX lint: " + ("FAIL" if bad else "PASS"))
+sys.exit(bad)
+PYEOF
+
+echo
+if [ "$rc" = 0 ]; then
+  echo "ALL CHECKS PASSED on the synthetic fixture (no real measurement involved)."
+else
+  echo "SOME CHECKS FAILED - fix the analyser before trusting a real capture."
+fi
+exit $rc
