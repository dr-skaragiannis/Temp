@@ -0,0 +1,52 @@
+#!/usr/bin/env bash
+# sync_probes.sh — keep the Route A copies of the probe classes identical to the canonical ones.
+#
+#   evaluation/meter/probes/*.kt                     canonical (used by the meter APK)
+#   evaluation/android/src/main/java/org/meshcrowd/probes/   the campaign build's copies
+#
+# Two trees, one source of truth. Run this after editing a probe, and run it with --check in CI or
+# before a measurement session: a mismatch means the campaign APK and the meter APK would count
+# different things, which invalidates any comparison between them.
+set -u -o pipefail
+shopt -s nullglob
+cd "$(dirname "$0")/.."                       # -> evaluation/meter
+SRC=probes
+DST=../android/src/main/java/org/meshcrowd/probes
+
+case "${1:-}" in
+  --check)
+    st=0
+    mkdir -p "$DST"
+    for f in "$SRC"/*.kt; do
+      b=$(basename "$f")
+      if ! cmp -s "$f" "$DST/$b"; then
+        echo "DRIFT: $b differs between $SRC and $DST"
+        echo "       fix with: scripts/sync_probes.sh"
+        st=1
+      fi
+    done
+    for f in "$DST"/*.kt; do
+      b=$(basename "$f")
+      [ -f "$SRC/$b" ] || { echo "STRAY: $DST/$b has no canonical counterpart"; st=1; }
+    done
+    [ "$st" = 0 ] && echo "probes in sync ($(ls "$SRC"/*.kt | wc -l) files)"
+    exit "$st"
+    ;;
+  ""|--force)
+    mkdir -p "$DST"
+    n=0
+    for f in "$SRC"/*.kt; do
+      cp -f "$f" "$DST/$(basename "$f")" && n=$((n+1))
+    done
+    echo "copied $n file(s) to $DST"
+    # the campaign tree may hold a probe that was later removed upstream
+    for f in "$DST"/*.kt; do
+      [ -f "$SRC/$(basename "$f")" ] || { echo "removing stray $(basename "$f")"; rm -f "$f"; }
+    done
+    "$0" --check
+    ;;
+  *)
+    echo "usage: scripts/sync_probes.sh [--check|--force]" >&2
+    exit 2
+    ;;
+esac
